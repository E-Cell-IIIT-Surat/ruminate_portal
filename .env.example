# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ruminate_portal?schema=public"

# Auth.js / Google OAuth
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SUPER_ADMIN_EMAILS=""

# Cloudflare R2 (private bucket only)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PRIVATE_BUCKET="ruminate-private"

# Email: console | resend
EMAIL_PROVIDER="console"
EMAIL_FROM="Ruminate Portal <portal@ecelliiitsurat.in>"
RESEND_API_KEY=""

# Optional secret for a scheduled POST to /api/internal/email/process
CRON_SECRET=""

# Optional guest endpoint protection
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Runtime
APP_URL="http://localhost:3000"
NODE_ENV="development"
