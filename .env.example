# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ruminate_portal?schema=public"

# Auth.js / Google OAuth
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SUPER_ADMIN_EMAILS="ruminate.ecell@iiitsurat.ac.in,nishad.deshpande@iiitsurat.ac.in"
UDHBHAV_ADMIN_EMAILS="nishad.deshpande@iiitsurat.ac.in"

# Cloudflare R2 (private bucket only)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PRIVATE_BUCKET="ruminate-private"

# Email: console | resend
EMAIL_PROVIDER="console"
EMAIL_FROM="Ruminate Portal <portal@ecelliiitsurat.in>"
RESEND_API_KEY=""

# Optional secret for a scheduled POST to /api/internal/email/process
CRON_SECRET=""

# Optional guest endpoint protection
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Runtime
APP_URL="http://localhost:3000"
NODE_ENV="development"
# Optional: set true only when intentionally testing the Cloudflare/Miniflare
# Worker runtime locally. Normal `npm run dev` uses the stable Node runtime.
CLOUDFLARE_DEV="false"
